<UserControl x:Class="ShopApp.UI.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,2"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="RightCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="TotalLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="10">

    <!-- HEADER -->
    <Border DockPanel.Dock="Top" Background="#F9FAFB" BorderBrush="#E5E7EB"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Bill To *" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding Customer}"
                    DisplayMemberPath="Name" IsEditable="True"
                    IsTextSearchEnabled="True" TextSearch.TextPath="Name"/>
          <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6B7280"
                     Text="{Binding CustomerBalance, StringFormat=Current balance: {0:N2}}"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Invoice No." Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding NextInvoiceNo, Mode=OneWay}" IsReadOnly="True"
                   Background="#F3F4F6" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
          <DatePicker SelectedDate="{Binding Date}"/>
        </StackPanel>

        <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
          <Button Content="New sale" Padding="12,5" Command="{Binding NewSaleCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- FOOTER -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="250"/>
          <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="Amount in words" Style="{StaticResource FieldLabel}"/>
          <TextBlock Text="{Binding TotalInWords}" TextWrapping="Wrap"
                     FontStyle="Italic" Foreground="#374151"/>

          <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="42"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="0,0,14,0">
          <Button Padding="12,10" FontWeight="SemiBold"
                  Command="{Binding PrintSettingsCommand}"
                  ToolTip="Choose what prints on this invoice">
            <StackPanel>
              <TextBlock Text="Invoice Print Settings" HorizontalAlignment="Center"/>
              <TextBlock Text="Received, Balance, Current Balance..." FontSize="10"
                         Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
          </Button>

          <TextBlock Text="Printing on this bill:" FontSize="11" Foreground="#6B7280"
                     Margin="0,10,0,2"/>
          <CheckBox Content="Received amount" Margin="0,2" FontSize="12"
                    IsChecked="{Binding ShowReceivedAmount}"/>
          <CheckBox Content="Balance amount" Margin="0,2" FontSize="12"
                    IsChecked="{Binding ShowBalanceAmount}"/>
          <CheckBox Content="Party current balance" Margin="0,2" FontSize="12"
                    IsChecked="{Binding ShowPartyCurrentBalance}"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/>
              <RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Sub Total" Style="{StaticResource TotalLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                       FontWeight="SemiBold" Text="{Binding SubTotal, StringFormat=N2}"/>

            <TextBlock Grid.Row="1" Text="Discount" Style="{StaticResource TotalLabel}"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Width="110" TextAlignment="Right"
                       Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}"/>

            <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6"/>

            <TextBlock Grid.Row="3" Text="Total" FontSize="16" FontWeight="Bold"/>
            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" Text="{Binding Total, StringFormat=N2}"/>

            <TextBlock Grid.Row="4" Text="Received" Style="{StaticResource TotalLabel}"/>
            <TextBox   Grid.Row="4" Grid.Column="1" Width="110" TextAlignment="Right"
                       Text="{Binding PaidNow, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="5" Text="Balance" Style="{StaticResource TotalLabel}"/>
            <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right"
                       Foreground="#B91C1C" FontWeight="SemiBold"
                       Text="{Binding Balance, StringFormat=N2}"/>
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <ComboBox Width="100" ItemsSource="{Binding PaymentModes}"
                      SelectedItem="{Binding PaymentMode}"/>
            <Button Content="Save" Margin="8,0,0,0" Padding="14,7"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Save &amp; Print" Margin="8,0,0,0" Padding="14,7"
                    FontWeight="Bold" Background="#1B7A9E" Foreground="White"
                    BorderThickness="0" Command="{Binding SaveAndPrintCommand}"/>
          </StackPanel>

          <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D"
                     Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- LINES -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Items" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="+ Add row" Margin="12,0,0,0" Padding="10,3"
                Command="{Binding AddLineCommand}"/>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7280"
                   FontSize="11"
                   Text="Batches are picked automatically, soonest expiry first."/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                CanUserAddRows="False" SelectionMode="Single"
                HeadersVisibility="Column" RowHeight="30">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding ShortOfStock}" Value="True">
                <Setter Property="Background" Value="#FEE2E2"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>

          <DataGridTemplateColumn Header="Item Name" Width="2.4*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox SelectedItem="{Binding Item, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.AvailableItems,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name" IsEditable="True"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          BorderThickness="0" Background="Transparent"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Packs" Width="70"
                              Binding="{Binding PackQty, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Quantity" Width="100"
                              Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Unit" Width="70" IsReadOnly="True"
                              Binding="{Binding UnitLabel}"/>

          <DataGridTextColumn Header="In stock" Width="90" IsReadOnly="True"
                              Binding="{Binding Available, StringFormat=N3}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Price/Unit" Width="100"
                              Binding="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Amount" Width="120" IsReadOnly="True"
                              Binding="{Binding Amount, StringFormat=N2}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTemplateColumn Width="40">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="X" Foreground="#B91C1C" BorderThickness="0"
                        Background="Transparent" ToolTip="Remove row"
                        Command="{Binding DataContext.RemoveLineCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</UserControl>
