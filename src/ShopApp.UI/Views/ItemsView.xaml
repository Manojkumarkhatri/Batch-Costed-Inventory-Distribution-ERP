<UserControl x:Class="ShopApp.UI.Views.ItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="330" MinWidth="240"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*" MinWidth="420"/>
    </Grid.ColumnDefinitions>

    <!-- ======================= LEFT: the item list ======================= -->
    <Border Grid.Column="0" Style="{StaticResource Panel}">
      <DockPanel Margin="12">

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" VerticalContentAlignment="Center" Padding="6,5"
                   Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   ToolTip="Search by item name"/>
          <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,5" Content="+ Add Item"
                  FontWeight="SemiBold" Foreground="White" Background="#D97706"
                  BorderThickness="0" Cursor="Hand"
                  Command="{Binding NewCommand}"/>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
          <ComboBox Width="110" ItemsSource="{Binding Categories}"
                    SelectedItem="{Binding CategoryFilter}"
                    VerticalContentAlignment="Center"/>
          <CheckBox Content="Inactive" Margin="8,0,0,0" VerticalAlignment="Center"
                    IsChecked="{Binding ShowInactive}"/>
          <Button Content="Clear" Margin="8,0,0,0" Padding="8,3"
                  Command="{Binding ClearFiltersCommand}"/>
          <Button Content="Import CSV" Margin="6,0,0,0" Padding="8,3"
                  Command="{Binding ImportCommand}"
                  ToolTip="Bulk-add items from a CSV file"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" Margin="2,8,0,0"/>

        <DataGrid ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedRow}"
                  IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0"
                  HorizontalScrollBarVisibility="Disabled">
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                  <Setter Property="Foreground" Value="#94A3B8"/>
                  <Setter Property="FontStyle" Value="Italic"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn Header="ITEM" Binding="{Binding Name}" Width="*"/>
            <DataGridTextColumn Header="QUANTITY" Width="100"
                                Binding="{Binding OnHand, StringFormat=N2}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- ==================== RIGHT: detail and history ==================== -->
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- summary card -->
      <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
        <StackPanel>

          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Remove" Padding="10,6" Margin="0,0,8,0" Cursor="Hand"
                      Foreground="#B91C1C" Background="Transparent" BorderThickness="0"
                      Command="{Binding DeleteCommand}"
                      ToolTip="An item with history is deactivated, not deleted - past invoices must keep working"/>
              <Button Content="EDIT" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"
                      Command="{Binding EditCommand}"/>
              <Button Content="ADJUST ITEM" Padding="14,6" FontWeight="SemiBold"
                      Foreground="White" Background="#2563EB" BorderThickness="0"
                      Cursor="Hand" Command="{Binding AdjustCommand}"
                      ToolTip="Record damage, spillage, expiry or a physical count correction"/>
            </StackPanel>
            <TextBlock Text="{Binding SelectedItem.Name}" FontSize="18" FontWeight="Bold"
                       Foreground="#0F172A" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </DockPanel>

          <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="SALE PRICE" Style="{StaticResource Caption}"/>
              <TextBlock Style="{StaticResource Figure}" Foreground="#15803D"
                         Text="{Binding SelectedItem.DefaultSalePrice, StringFormat=Rs {0:N2}}"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
              <TextBlock Text="PURCHASE PRICE" Style="{StaticResource Caption}"/>
              <TextBlock Style="{StaticResource Figure}" Foreground="#B45309"
                         Text="{Binding SelectedItem.DefaultPurchasePrice, StringFormat=Rs {0:N2}}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="STOCK QUANTITY" Style="{StaticResource Caption}"/>
              <TextBlock Style="{StaticResource Figure}">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0:N3} {1}">
                    <Binding Path="SelectedOnHand"/>
                    <Binding Path="SelectedItem.BaseUnit"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="3">
              <TextBlock Text="STOCK VALUE" Style="{StaticResource Caption}"
                         ToolTip="Each batch's remaining quantity at its own landed cost"/>
              <TextBlock Style="{StaticResource Figure}"
                         Text="{Binding SelectedStockValue, StringFormat=Rs {0:N2}}"/>
            </StackPanel>
          </Grid>

        </StackPanel>
      </Border>

      <!-- transactions -->
      <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="16"
              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="TRANSACTIONS" FontWeight="Bold"
                     Foreground="#334155" Margin="0,0,0,10"/>

          <DataGrid ItemsSource="{Binding History}" IsReadOnly="True"
                    HeadersVisibility="Column"
                    BorderThickness="0">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontStyle" Value="Italic"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="1.2*"/>
              <DataGridTextColumn Header="INVOICE / REF NO" Binding="{Binding RefNo}" Width="1.2*"/>
              <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="1.8*"/>
              <DataGridTextColumn Header="DATE" Width="110"
                                  Binding="{Binding Date, StringFormat=dd-MMM-yyyy}"/>
              <DataGridTextColumn Header="QUANTITY" Width="100"
                                  Binding="{Binding Qty, StringFormat=N3}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Style.Triggers>
                      <!-- stock leaving the shelf reads red, arriving reads green -->
                      <DataTrigger Binding="{Binding IsOutward}" Value="True">
                        <Setter Property="Foreground" Value="#B91C1C"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="PRICE / UNIT" Width="110"
                                  Binding="{Binding PricePerUnit, StringFormat=N2}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>

      <!-- nothing picked yet -->
      <Border Grid.Row="0" Grid.RowSpan="3">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasSelection}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Pick an item on the left" FontSize="15" Foreground="#94A3B8"/>
          <TextBlock Text="Its stock, value and full history appear here."
                     Foreground="#CBD5E1" FontSize="12" Margin="0,6,0,0"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
