<!--
  What he sees instead of the window disappearing.

  The first line is the only one that matters to him: his data is safe. The
  detail is there for us, folded away, with a button that puts it on the
  clipboard so a report arrives as text rather than a description.
-->
<Window x:Class="ShopApp.UI.Views.CrashDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Something went wrong" Height="460" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{StaticResource Surface}" ShowInTaskbar="True">

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="{StaticResource NegativeWash}"
            BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="20,16">
      <StackPanel>
        <TextBlock Text="Something went wrong" FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource NegativeDeep}"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource NegativeDeep}"
                   Text="Your data is safe. Nothing that was already saved has been lost, and anything you were part-way through was not written."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <!-- The path goes on its own line. Docked beside the buttons it ran
           underneath them as soon as the user profile name was long. -->
      <StackPanel>
        <TextBlock x:Name="LogPathText" Style="{StaticResource Hint}"
                   Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Copy details" Margin="0,0,8,0" Click="Copy_Click"/>
          <Button Content="Open log folder" Margin="0,0,8,0" Click="OpenFolder_Click"/>
          <Button x:Name="ContinueButton" Content="Continue" MinWidth="110"
                  Style="{StaticResource PrimaryButton}" Click="Continue_Click"
                  IsDefault="True"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Margin="20,16,20,12">
      <TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="13"/>

      <Expander Header="Technical detail" IsExpanded="True" Margin="0,14,0,0" Foreground="{StaticResource Muted}">
        <Border Background="{StaticResource Wash}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
          <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
            <TextBox x:Name="Detail" IsReadOnly="True" BorderThickness="0"
                     Background="Transparent" TextWrapping="NoWrap"
                     FontFamily="{StaticResource NumFont}" FontSize="11"
                     HorizontalScrollBarVisibility="Auto"/>
          </ScrollViewer>
        </Border>
      </Expander>
    </StackPanel>
  </DockPanel>
</Window>
