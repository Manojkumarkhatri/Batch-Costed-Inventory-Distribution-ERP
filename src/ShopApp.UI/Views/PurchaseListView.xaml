<UserControl x:Class="ShopApp.UI.Views.PurchaseListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShopApp.UI.Views">

  <UserControl.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="6">

    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="+  Add Purchase" Padding="18,7"
                FontWeight="SemiBold" Foreground="White" Background="#2563EB"
                BorderThickness="0" Command="{Binding AddPurchaseCommand}" ToolTip="F3"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Filter by:" Style="{StaticResource Caption}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox MinWidth="120" ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding Period}"/>
          <DatePicker Margin="8,0,0,0" SelectedDate="{Binding FromDate}"/>
          <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
          <DatePicker SelectedDate="{Binding ToDate}"/>
          <TextBox Width="200" Margin="16,0,0,0"
                   Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   ToolTip="Search by supplier name or bill number"/>
          <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
        <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="TOTAL PURCHASE AMOUNT" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TotalPurchases, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
        <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="PAID" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValuePositive}" Text="{Binding TotalPaid, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
        <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="BALANCE" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValueNegative}" Text="{Binding TotalBalance, StringFormat=Rs {0:N0}}"/>
          <TextBlock Style="{StaticResource KpiSub}" Text="Cancelled bills excluded"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="2,8,2,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Correct this bill" Margin="0,0,8,0"
                  Command="{Binding CorrectCommand}" IsEnabled="{Binding HasSelection}"
                  ToolTip="Cancels the bill and opens a blank form to enter it again"/>
          <Button Content="Cancel bill" Foreground="#B91C1C"
                  Command="{Binding CancelPurchaseCommand}" IsEnabled="{Binding HasSelection}"
                  ToolTip="Takes the stock back off the shelf and reverses the supplier's balance"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,8,0,0">
      <Grid>
      <DataGrid x:Name="Rows" ItemsSource="{Binding Purchases}" SelectedItem="{Binding SelectedPurchase}"
                IsReadOnly="True">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="FontStyle" Value="Italic"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Width="110"
                              Binding="{Binding Date, StringFormat=dd-MMM-yyyy}"/>
          <DataGridTextColumn Header="BILL NO" Binding="{Binding Number}" Width="120"/>
          <DataGridTextColumn Header="SUPPLIER" Binding="{Binding PartyName}" Width="2*"/>
          <DataGridTextColumn Header="TRANSACTION" Binding="{Binding Transaction}" Width="110"/>
          <DataGridTextColumn Header="PAYMENT TYPE" Binding="{Binding PaymentType}" Width="120"/>
          <DataGridTextColumn Header="AMOUNT" Width="130"
                              Binding="{Binding Amount, StringFormat=N2}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="BALANCE" Width="130"
                              Binding="{Binding Balance, StringFormat=N2}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B91C1C"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Balance}" Value="0">
                    <Setter Property="Foreground" Value="#15803D"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <v:EmptyState Message="No bills in this period"
                    Hint="Change the date range, or press Add Purchase to record one."
                    Visibility="{Binding HasItems, ElementName=Rows, Converter={StaticResource NotToVis}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
