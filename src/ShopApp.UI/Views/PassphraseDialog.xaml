<Window x:Class="ShopApp.UI.Views.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup passphrase" Height="480" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,3"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1" Padding="20,14">
      <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="18,7" MinWidth="90" Click="Cancel_Click"
                IsCancel="True"/>
        <Button x:Name="OkButton" Content="OK" Padding="18,7" MinWidth="120" Margin="10,0,0,0"
                FontWeight="SemiBold" Foreground="White" Background="#2563EB"
                BorderThickness="0" Click="Ok_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,4,20,20">

        <Border x:Name="WarningPanel" Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,10,0,0">
          <StackPanel>
            <TextBlock Text="Write this down on paper before you continue"
                       FontWeight="Bold" Foreground="#991B1B"/>
            <TextBlock Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Every backup is encrypted with this passphrase. Nobody can recover it for you - not the shop, not the software, not Windows. If the PC dies and the passphrase is lost, every backup on the USB stick is permanently unreadable."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="FirstLabel" Text="Passphrase" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="FirstBox" Padding="8,7" FontSize="15"/>

        <StackPanel x:Name="ConfirmPanel">
          <TextBlock Text="Type it again" Style="{StaticResource FieldLabel}"/>
          <PasswordBox x:Name="SecondBox" Padding="8,7" FontSize="15"/>

          <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Use something long and memorable rather than short and clever - four ordinary words are stronger than one word with symbols in it, and far easier to copy off a piece of paper correctly."/>

          <CheckBox x:Name="WrittenDownBox" Margin="0,16,0,0"
                    Content="I have written this passphrase down and stored it away from the PC"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
