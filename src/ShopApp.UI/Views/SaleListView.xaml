<!--
  ===================================================================
  REFERENCE SCREEN for list views.

  Payment-In, Payment-Out, Purchase Bills and Expenses should copy this
  file's patterns exactly: one filter strip, a compact KPI row, then a
  table that declares no styles of its own.

  Every column names a cell style. Anything that can be empty goes
  through the Dash converter.
  ===================================================================
-->
<UserControl x:Class="ShopApp.UI.Views.SaleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShopApp.UI.Views">

  <DockPanel Margin="14,12,14,12">

    <!-- ========================= filter strip ========================= -->
    <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="+  Add Sale"
                Style="{StaticResource SaleButton}"
                Command="{Binding AddSaleCommand}" ToolTip="F2"/>

        <StackPanel Orientation="Horizontal">
          <ComboBox Width="130" ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}"/>
          <DatePicker Width="135" Margin="10,0,0,0" SelectedDate="{Binding FromDate}"/>
          <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0"
                     Foreground="{StaticResource Faint}"/>
          <DatePicker Width="135" SelectedDate="{Binding ToDate}"/>

          <Grid Width="200" Margin="16,0,0,0">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=250}"/>
            <TextBlock Text="Party or invoice no">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Watermark}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>

          <Button Content="Clear" Margin="10,0,0,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================== KPIs ============================== -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,-12,12">
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="TOTAL SALES" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValue}"
                     Text="{Binding TotalSales, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="RECEIVED" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValuePositive}"
                     Text="{Binding TotalReceived, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="BALANCE" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValueNegative}"
                     Text="{Binding TotalBalance, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- ============================ actions ============================ -->
    <Border DockPanel.Dock="Bottom" Padding="2,10,2,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusLine}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Print / save PDF" Margin="0,0,8,0"
                  Command="{Binding PrintCommand}" IsEnabled="{Binding HasSelection}"/>
          <Button Content="Cancel invoice" Style="{StaticResource DangerButton}"
                  Command="{Binding CancelSaleCommand}" IsEnabled="{Binding HasSelection}"
                  ToolTip="Puts the stock back and reverses the balance"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================= table ============================= -->
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="10">
      <Grid>
        <DataGrid x:Name="Rows" ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale}"
                  IsReadOnly="True" BorderThickness="0"
                  AlternationCount="1000000"
                  RowStyle="{StaticResource VoidedRow}">
          <DataGrid.Columns>

            <!-- Serial. Bound to the row's position, not to the data. -->
            <DataGridTextColumn Header="#" Width="46"
                                HeaderStyle="{StaticResource NumberColumnHeader}"
                                ElementStyle="{StaticResource RowNumberCell}"
                                Binding="{Binding (ItemsControl.AlternationIndex),
                                          RelativeSource={RelativeSource AncestorType=DataGridRow},
                                          Converter={StaticResource RowNo}}"/>

            <DataGridTextColumn Header="DATE" Width="120"
                                ElementStyle="{StaticResource DateCell}"
                                Binding="{Binding Date, StringFormat=dd-MM-yyyy}"/>

            <DataGridTemplateColumn Header="TYPE" Width="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Margin="14,0">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Transaction}" Value="Sale">
                            <Setter Property="Background" Value="{StaticResource NegativeWash}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Transaction}" Style="{StaticResource BadgeText}"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn Header="INVOICE NO" Width="120"
                                ElementStyle="{StaticResource TextCell}"
                                Binding="{Binding InvoiceNo, Converter={StaticResource Dash}}"/>

            <DataGridTextColumn Header="PARTY" Width="2*"
                                ElementStyle="{StaticResource TextCell}"
                                Binding="{Binding PartyName}"/>

            <DataGridTextColumn Header="PAYMENT" Width="110"
                                ElementStyle="{StaticResource TextCell}"
                                Binding="{Binding PaymentType}"/>

            <DataGridTextColumn Header="AMOUNT" Width="140"
                                HeaderStyle="{StaticResource NumberColumnHeader}"
                                ElementStyle="{StaticResource NumberCell}"
                                Binding="{Binding Amount, StringFormat=N0}"/>

            <DataGridTextColumn Header="BALANCE" Width="140"
                                HeaderStyle="{StaticResource NumberColumnHeader}"
                                Binding="{Binding Balance, StringFormat=N0}">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyOutCell}">
                  <Style.Triggers>
                    <!-- Settled reads quietly; still owing reads red. -->
                    <DataTrigger Binding="{Binding Balance}" Value="0">
                      <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                      <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <v:EmptyState Message="No invoices in this period"
                      Hint="Change the date range, or press Add Sale to record one."
                      Visibility="{Binding HasItems, ElementName=Rows,
                                   Converter={StaticResource NotToVis}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
