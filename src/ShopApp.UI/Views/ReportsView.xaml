<UserControl x:Class="ShopApp.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ShopApp.UI.Converters"
             xmlns:v="clr-namespace:ShopApp.UI.Views">

  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding ToggleListCommand}"/>
  </UserControl.InputBindings>

  <UserControl.Resources>
    <conv:NavActiveConverter x:Key="ReportSelected"/>

    <!-- A full-width band above each block of a grouped report. -->
    <GroupStyle x:Key="ReportGroupStyle">
      <GroupStyle.HeaderTemplate>
        <DataTemplate>
          <Border Background="{StaticResource SectionRow}"
                  BorderBrush="{StaticResource LineMid}" BorderThickness="0,0,0,1"
                  Padding="16,8">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeadingText}"/>
              <!-- The row's own count, not the group's: the group includes
                   the subtotal row, which is not an entry. -->
              <TextBlock Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource Dim}">
                <Run Text="{Binding Items[0].SectionCount, Mode=OneWay}"/><Run Text=" entries"/>
              </TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </GroupStyle.HeaderTemplate>
    </GroupStyle>

    <!-- The back arrow. Only a chevron, sized to sit beside the report name. -->
    <Style x:Key="BackArrow" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,0,8,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding ListWidth}" MinWidth="0"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ====================== the list of reports ======================
         Double-click a report to give the table the whole window.
    -->
    <Border Grid.Column="0" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Name}" Style="{StaticResource NavGroupHead}"/>
                <ItemsControl ItemsSource="{Binding Reports}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <RadioButton GroupName="Reports"
                                   Style="{StaticResource NavListItem}"
                                   Content="{Binding Name}"
                                   ToolTip="{Binding Description}"
                                   Checked="ReportRadio_Checked"
                                   MouseDoubleClick="ReportItem_DoubleClick"
                                   Tag="{Binding}">
                        <RadioButton.IsChecked>
                          <MultiBinding Converter="{StaticResource ReportSelected}" Mode="OneWay">
                            <Binding Path="DataContext.SelectedReport"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            <Binding/>
                          </MultiBinding>
                        </RadioButton.IsChecked>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- =========================== the report ===========================
         One filter strip, then the table. The report's name in the list is
         its title, so the screen carries no heading of its own.
    -->
    <DockPanel Grid.Column="1" Margin="14,12,14,12">

      <Border DockPanel.Dock="Top" Background="{StaticResource Surface}"
              BorderBrush="{StaticResource Line}" BorderThickness="1"
              CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
        <StackPanel>

          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0"/>
              <Button Content="PDF" Command="{Binding ExportPdfCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
              <!-- Shown only when the list is hidden - it is the way back. -->
              <Button Content="&#x2039;" Style="{StaticResource BackArrow}"
                      Command="{Binding ToggleListCommand}"
                      ToolTip="Show the report list (Esc)"
                      Visibility="{Binding ListCollapsed, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{Binding Result.Title}" FontSize="16" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>

          <StackPanel Orientation="Horizontal" Visibility="{Binding FilterBarVisible}">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding DateFilterVisible}">
              <ComboBox Width="130" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/>
              <DatePicker Width="135" Margin="10,0,0,0" SelectedDate="{Binding FromDate}"/>
              <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0"
                         Foreground="{StaticResource Faint}"/>
              <DatePicker Width="135" SelectedDate="{Binding ToDate}"/>
            </StackPanel>

            <Grid Width="170" Margin="16,0,0,0" Visibility="{Binding PartyFilterVisible}">
              <ComboBox ItemsSource="{Binding Parties}" SelectedItem="{Binding SelectedParty}"
                        DisplayMemberPath="Name"/>
              <TextBlock Text="All parties" Style="{StaticResource Watermark}"
                         Visibility="{Binding SelectedParty, Converter={StaticResource NullToVis}}"/>
            </Grid>

            <Grid Width="170" Margin="10,0,0,0" Visibility="{Binding ItemFilterVisible}">
              <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                        DisplayMemberPath="Name"/>
              <TextBlock Text="All items" Style="{StaticResource Watermark}"
                         Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}"/>
            </Grid>

            <Grid Width="150" Margin="10,0,0,0" Visibility="{Binding CategoryFilterVisible}">
              <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
              <TextBlock Text="All categories" Style="{StaticResource Watermark}"
                         Visibility="{Binding SelectedCategory, Converter={StaticResource NullToVis}}"/>
            </Grid>

            <Button Content="Clear" Margin="10,0,0,0" Command="{Binding ClearFiltersCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="10">
        <DockPanel>

          <Border DockPanel.Dock="Bottom" Background="{StaticResource Wash}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                  CornerRadius="0,0,9,9" Padding="16,11"
                  Visibility="{Binding TotalsVisible}">
            <TextBlock Text="{Binding TotalsLine}" HorizontalAlignment="Right"
                       FontFamily="{StaticResource NumFont}" FontWeight="SemiBold"
                       FontSize="13" Foreground="{StaticResource Ink}"/>
          </Border>

          <Grid>
          <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserSortColumns="False" BorderThickness="0">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSummaryRow}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Background" Value="{StaticResource SubtotalRow}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
          </DataGrid>

          <v:EmptyState Message="Nothing in this period"
                        Hint="Change the date range or clear the filters."
                        Visibility="{Binding HasItems, ElementName=ReportGrid,
                                     Converter={StaticResource NotToVis}}"/>
          </Grid>
        </DockPanel>
      </Border>
    </DockPanel>
  </Grid>
</UserControl>
