<UserControl x:Class="ShopApp.UI.Views.PaymentInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShopApp.UI.Views">

  <UserControl.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="6">

    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="+  Add Payment-In" Padding="18,7"
                FontWeight="SemiBold" Foreground="White" Background="#DC2626"
                BorderThickness="0" Cursor="Hand"
                Command="{Binding AddPaymentCommand}"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Filter by:" Style="{StaticResource Caption}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox MinWidth="120" ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding Period}" VerticalContentAlignment="Center"/>
          <DatePicker Margin="8,0,0,0" SelectedDate="{Binding FromDate}"/>
          <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
          <DatePicker SelectedDate="{Binding ToDate}"/>
          <TextBox Width="200" Margin="16,0,0,0" Padding="6,4"
                   VerticalContentAlignment="Center"
                   Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                   ToolTip="Search by party name or reference number"/>
          <Button Content="Clear" Margin="8,0,0,0" Padding="10,4"
                  Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="TOTAL RECEIVED" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValuePositive}" Text="{Binding TotalAmount, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="ON ACCOUNT" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValueWarn}" Text="{Binding TotalOnAccount, StringFormat=Rs {0:N0}}"/>
          <TextBlock Style="{StaticResource KpiSub}" Text="Not tied to an invoice yet"/>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="2,8,2,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
        <Button HorizontalAlignment="Right" Content="Delete payment" Padding="14,6"
                Foreground="#B91C1C" Command="{Binding DeletePaymentCommand}"
                IsEnabled="{Binding HasSelection}"
                ToolTip="The invoices it settled go back to unpaid"/>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,8,0,0">
      <Grid>
      <DataGrid x:Name="Rows" ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0">
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Width="110"
                              Binding="{Binding Date, StringFormat=dd-MMM-yyyy}"/>
          <DataGridTextColumn Header="PARTY NAME" Binding="{Binding PartyName}" Width="2*"/>
          <DataGridTextColumn Header="MODE" Binding="{Binding Mode}" Width="90"/>
          <DataGridTextColumn Header="REFERENCE" Binding="{Binding ReferenceNo}" Width="*"/>
          <DataGridTextColumn Header="AMOUNT" Width="130"
                              Binding="{Binding Amount, StringFormat=N2}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#15803D"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="SETTLES" Binding="{Binding Settles}" Width="1.6*"/>
        </DataGrid.Columns>
      </DataGrid>
      <v:EmptyState Message="No payments in this period"
                    Hint="Change the date range, or press Add Payment-In to record one."
                    Visibility="{Binding HasItems, ElementName=Rows, Converter={StaticResource NotToVis}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
