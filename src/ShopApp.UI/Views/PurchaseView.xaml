<UserControl x:Class="ShopApp.UI.Views.PurchaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,6,0,2"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="RightCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="TotalLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style x:Key="TotalValue" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="10">

    <!-- HEADER -->
    <Border DockPanel.Dock="Top" Background="#F9FAFB" BorderBrush="#E5E7EB"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="Supplier *" Style="{StaticResource FieldLabel}"/>
          <ComboBox ItemsSource="{Binding Suppliers}"
                    SelectedItem="{Binding Supplier}"
                    DisplayMemberPath="Name"
                    IsEditable="True" IsTextSearchEnabled="True"
                    TextSearch.TextPath="Name"/>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Supplier bill no" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding SupplierBillNo}"/>
        </StackPanel>

        <StackPanel Grid.Column="4">
          <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
          <DatePicker SelectedDate="{Binding Date}"/>
        </StackPanel>

        <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
          <Button Content="New purchase" Padding="12,5"
                  Command="{Binding NewPurchaseCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- FOOTER: totals + actions -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" Height="52"/>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Width="130">
              <TextBlock Text="Paid now" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding PaidNow, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="130" Margin="10,0,0,0">
              <TextBlock Text="Mode" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding PaymentMode}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/>
              <RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sub total" Style="{StaticResource TotalLabel}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource TotalValue}"
                       Text="{Binding SubTotal, StringFormat=N2}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" Style="{StaticResource TotalLabel}"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Width="110" TextAlignment="Right"
                       Text="{Binding Discount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TotalLabel}"
                       Text="Freight / other" ToolTip="Split across items by value and added to batch cost"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Width="110" TextAlignment="Right"
                       Text="{Binding OtherCharges, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>

            <Separator Grid.Row="3" Grid.ColumnSpan="2" Margin="0,6"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Total" FontSize="16" FontWeight="Bold"/>
            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" Text="{Binding Total, StringFormat=N2}"/>
          </Grid>

          <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right" Foreground="#B91C1C"
                     Text="{Binding Balance, StringFormat=Balance due: {0:N2}}"/>

          <Button Content="{Binding SaveButtonText}" Margin="0,12,0,0" Padding="16,8"
                  FontWeight="Bold" FontSize="14"
                  Command="{Binding SaveCommand}"/>

          <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D"
                     Margin="0,6,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- LINES -->
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <TextBlock Text="Items received" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Content="+ Add row" Margin="12,0,0,0" Padding="10,3"
                Command="{Binding AddLineCommand}"/>
        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7280"
                   FontSize="11"
                   Text="Leave batch blank to auto-number. Quantity is in the base unit."/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                Style="{StaticResource EntryGrid}"
                CanUserAddRows="False" SelectionMode="Single"
                HeadersVisibility="Column" RowHeight="30">
        <DataGrid.Columns>

          <DataGridTemplateColumn Header="Item" Width="2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox SelectedItem="{Binding Item, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.AvailableItems,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name"
                          IsEditable="True" IsTextSearchEnabled="True"
                          TextSearch.TextPath="Name"
                          BorderThickness="0" Background="Transparent"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Batch" Width="100"
                              Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"/>

          <DataGridTemplateColumn Header="Mfg date" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DatePicker SelectedDate="{Binding MfgDate, UpdateSourceTrigger=PropertyChanged}"
                            BorderThickness="0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTemplateColumn Header="Expiry" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                            BorderThickness="0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Packs" Width="70"
                              Binding="{Binding PackQty, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Qty" Width="90"
                              Binding="{Binding Qty, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Unit" Width="80" IsReadOnly="True"
                              Binding="{Binding UnitLabel}"/>

          <DataGridTextColumn Header="Rate" Width="90"
                              Binding="{Binding Rate, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Amount" Width="110" IsReadOnly="True"
                              Binding="{Binding Amount, StringFormat=N2}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTemplateColumn Width="40">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="X" Foreground="#B91C1C" BorderThickness="0"
                        Background="Transparent" ToolTip="Remove row"
                        Command="{Binding DataContext.RemoveLineCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</UserControl>
