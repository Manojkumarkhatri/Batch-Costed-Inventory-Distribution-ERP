<Window x:Class="ShopApp.UI.Views.ItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Item" Height="620" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,10,0,3"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>

    <!--
      A price typed as "1,350" or left half-deleted cannot convert to decimal,
      so the binding quietly keeps the old value and Save writes the old number.
      This makes that state impossible to miss.
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="6,5"/>
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="True">
          <Setter Property="BorderBrush" Value="#B91C1C"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="ToolTip"
                  Value="{Binding RelativeSource={RelativeSource Self},
                          Path=(Validation.Errors)[0].ErrorContent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1" Padding="20,14">
      <TextBlock x:Name="HeaderText" Text="Add Item" FontSize="17" FontWeight="Bold"
                 Foreground="#0F172A"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="18,7" MinWidth="90" Click="Cancel_Click"
                IsCancel="True"/>
        <Button Content="Save" Padding="18,7" MinWidth="110" Margin="10,0,0,0"
                FontWeight="SemiBold" Foreground="White" Background="#2563EB"
                BorderThickness="0" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,4,20,20">

        <TextBlock Text="Item name *" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
        <ComboBox SelectedItem="{Binding Category}"
                  ItemsSource="{Binding Categories,
                                RelativeSource={RelativeSource AncestorType=Window}}"/>

        <TextBlock Text="Units" Style="{StaticResource SectionHead}"/>
        <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="Stock is held in the base unit. Add a pack unit if he buys in sacks, drums or cartons."/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Base unit *" Style="{StaticResource FieldLabel}"/>
            <ComboBox IsEditable="True"
                      Text="{Binding BaseUnit, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding CommonUnits,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Pack unit" Style="{StaticResource FieldLabel}"/>
            <ComboBox IsEditable="True"
                      Text="{Binding AltUnit, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding CommonUnits,
                                    RelativeSource={RelativeSource AncestorType=Window}}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="1 pack =" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ConversionFactor, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="ConversionPreview" Margin="0,8,0,0" Foreground="#15803D"
                   FontWeight="SemiBold"/>

        <CheckBox Content="Billed on actual weight" Margin="0,12,0,0"
                  IsChecked="{Binding IsVariableWeight}"
                  ToolTip="Pack has a nominal weight but is invoiced on what it actually weighs"/>

        <TextBlock Text="Pricing" Style="{StaticResource SectionHead}"/>
        <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="Defaults for the sale and purchase screens. Real cost comes from each batch as it is received, so these never affect profit or stock value."/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Sale price" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding DefaultSalePrice, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Purchase price" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding DefaultPurchasePrice, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>

        <TextBlock Text="Stock" Style="{StaticResource SectionHead}"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Reorder level" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ReorderLevel, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Warn before expiry (days)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding NearExpiryDays, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </Grid>

        <CheckBox Content="Active" Margin="0,16,0,0" IsChecked="{Binding IsActive}"/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
