<Window x:Class="ShopApp.UI.Views.PartyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Party" Height="640" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,3"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="6,5"/>
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="True">
          <Setter Property="BorderBrush" Value="#B91C1C"/>
          <Setter Property="BorderThickness" Value="2"/>
          <Setter Property="ToolTip"
                  Value="{Binding RelativeSource={RelativeSource Self},
                          Path=(Validation.Errors)[0].ErrorContent}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1" Padding="20,14">
      <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="18,7" MinWidth="90" Click="Cancel_Click"
                IsCancel="True"/>
        <Button Content="Save" Padding="18,7" MinWidth="110" Margin="10,0,0,0"
                FontWeight="SemiBold" Foreground="White" Background="#DC2626"
                BorderThickness="0" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,10,20,10">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Party name *" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
          <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Phone number" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
          <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Grid>

      <TabControl Margin="0,18,0,0" BorderThickness="0,1,0,0" BorderBrush="#E2E8F0"
                  Background="Transparent" Padding="0,14,0,0">

        <TabItem Header="Address">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
              <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

              <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
              <ComboBox x:Name="GroupBox" IsEditable="True"
                        Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                         Text="His own categorisation, e.g. Bakery or Wholesale. Type a new one or pick an existing."/>
            </StackPanel>

            <StackPanel Grid.Column="2">
              <TextBlock Text="Billing address" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                       Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"/>
              <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                         Text="Printed on the invoice exactly as typed here."/>
            </StackPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Credit and Balance">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="Opening balance" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>

              <StackPanel Grid.Column="2">
                <TextBlock Text="As on" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding OpeningBalanceDate}"/>
              </StackPanel>

              <StackPanel Grid.Column="4">
                <TextBlock Text="Credit limit" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=PropertyChanged}"/>
              </StackPanel>
            </Grid>

            <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="To Receive" GroupName="Direction"
                           VerticalAlignment="Center"
                           IsChecked="{Binding OpeningIsReceivable}"/>
              <RadioButton x:Name="ToPayRadio" Content="To Pay" GroupName="Direction"
                           Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Enter the opening balance as a positive figure and set the direction here. To Receive means they owe him; To Pay means he owes them. A credit limit of 0 means no limit is enforced."/>
          </StackPanel>
        </TabItem>

        <TabItem Header="Other">
          <StackPanel>
            <CheckBox Content="Active" Margin="0,14,0,0" IsChecked="{Binding IsActive}"/>
            <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Clear this to hide a party he no longer trades with. Nothing is deleted, so past invoices and reports keep working."/>
          </StackPanel>
        </TabItem>
      </TabControl>

    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
