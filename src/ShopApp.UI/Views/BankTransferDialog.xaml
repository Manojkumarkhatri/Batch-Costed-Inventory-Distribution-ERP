<Window x:Class="ShopApp.UI.Views.BankTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource DialogHeader}">
      <StackPanel>
        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="HeaderHint" Style="{StaticResource Hint}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" MinWidth="90" Click="Cancel_Click" IsCancel="True"/>
        <Button Content="Save" MinWidth="120" Margin="10,0,0,0"
                Style="{StaticResource SaleButton}" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,4,20,20">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock x:Name="FromLabel" Text="From" Style="{StaticResource Label}"/>
            <TextBox x:Name="FromBox" IsReadOnly="True"/>
          </StackPanel>
          <StackPanel x:Name="ToPanel" Grid.Column="2">
            <TextBlock Text="To" Style="{StaticResource Label}"/>
            <ComboBox x:Name="ToBox" DisplayMemberPath="Name"/>
          </StackPanel>
        </Grid>

        <Border Background="{StaticResource Wash}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="BALANCE NOW" Style="{StaticResource StatCaption}"/>
            <TextBlock x:Name="BalanceText" Style="{StaticResource FigureSmall}"/>
            <TextBlock x:Name="AfterText" Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock x:Name="AmountLabel" Text="Amount *" Style="{StaticResource Label}"/>
            <TextBox x:Name="AmountBox" FontSize="16" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Date" Style="{StaticResource Label}"/>
            <DatePicker x:Name="DateBox"/>
          </StackPanel>
        </Grid>

        <StackPanel x:Name="DirectionPanel" Visibility="Collapsed">
          <TextBlock Text="Direction" Style="{StaticResource Label}"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="IncreaseRadio" Content="Increase the balance"
                         GroupName="Direction" IsChecked="True"/>
            <RadioButton x:Name="DecreaseRadio" Content="Decrease the balance"
                         GroupName="Direction" Margin="20,0,0,0"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}"
                     Text="Use this only to make the app agree with a bank statement. Every other kind of movement belongs on one of the other entries."/>
        </StackPanel>

        <TextBlock Text="Description" Style="{StaticResource Label}"/>
        <TextBox x:Name="DescriptionBox" Height="72" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
