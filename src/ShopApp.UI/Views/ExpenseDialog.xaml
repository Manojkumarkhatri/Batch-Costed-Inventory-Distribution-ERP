<Window x:Class="ShopApp.UI.Views.ExpenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Expense" Height="660" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,3"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1" Padding="20,14">
      <StackPanel>
        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Money spent running the business - rent, wages, fuel, repairs. Buying stock is a purchase, not an expense: that is goods he still owns and can sell."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="18,7" MinWidth="90" Click="Cancel_Click"
                IsCancel="True"/>
        <Button Content="Save" Padding="18,7" MinWidth="120" Margin="10,0,0,0"
                FontWeight="SemiBold" Foreground="White" Background="#B45309"
                BorderThickness="0" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="20,4,20,20">

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Category *" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CategoryBox" IsEditable="True"/>
            <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                       Text="Pick one or type a new one. Whatever he types joins the list."/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
            <DatePicker x:Name="DateBox"/>
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Amount *" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="AmountBox" FontSize="16" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="This amount covers" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CoversBox" SelectionChanged="Covers_Changed"/>
          </StackPanel>
        </Grid>

        <!-- Only shown when he picks Custom; otherwise the dates follow the
             frequency and there is nothing for him to decide. -->
        <Grid x:Name="CustomRangePanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Covers from" Style="{StaticResource FieldLabel}"/>
            <DatePicker x:Name="CoversFromBox" SelectedDateChanged="Covers_DateChanged"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Covers to" Style="{StaticResource FieldLabel}"/>
            <DatePicker x:Name="CoversToBox" SelectedDateChanged="Covers_DateChanged"/>
          </StackPanel>
        </Grid>

        <Border x:Name="SpreadPanel" Background="#F0F9FF" BorderBrush="#BAE6FD"
                BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,14,0,0"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="SpreadHeadline" FontWeight="SemiBold" Foreground="#075985"/>
            <TextBlock x:Name="SpreadDetail" Foreground="#0C4A6E" FontSize="11"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NotesBox" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>
        <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                   Text="Worth filling in. In six months &quot;Repairs 12,000&quot; on its own tells him nothing."/>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
