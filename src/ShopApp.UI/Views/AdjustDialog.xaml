<Window x:Class="ShopApp.UI.Views.AdjustDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust Stock" Height="640" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="White" ShowInTaskbar="False">

  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,3"/>
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1" Padding="20,14">
      <StackPanel>
        <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
        <TextBlock Foreground="#94A3B8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Adjustments are added to the stock ledger, never edited into it. The original purchase stays exactly as it was recorded."/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Padding="18,7" MinWidth="90" Click="Cancel_Click"
                IsCancel="True"/>
        <Button Content="Record adjustment" Padding="18,7" MinWidth="150" Margin="10,0,0,0"
                FontWeight="SemiBold" Foreground="White" Background="#2563EB"
                BorderThickness="0" Click="Save_Click" IsDefault="True"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,4,20,20">

      <TextBlock Text="Batch" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="BatchBox" DisplayMemberPath="Display"
                SelectionChanged="BatchBox_SelectionChanged"/>
      <TextBlock x:Name="BatchNote" Foreground="#94A3B8" FontSize="11" Margin="0,5,0,0"/>

      <TextBlock Text="What happened" Style="{StaticResource FieldLabel}"/>
      <ComboBox x:Name="ReasonBox"/>

      <TextBlock Text="Direction" Style="{StaticResource FieldLabel}"/>
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="DecreaseRadio" Content="Decrease stock" IsChecked="True"
                     GroupName="Direction" VerticalAlignment="Center"/>
        <RadioButton x:Name="IncreaseRadio" Content="Increase stock" GroupName="Direction"
                     Margin="20,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Foreground="#94A3B8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"
                 Text="Damage, spillage, thaw loss, expiry and theft decrease stock. Use increase only for a physical count that found more than the books show."/>

      <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="QtyBox" Padding="6,5"/>

      <TextBlock Text="Description (optional)" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="NoteBox" Padding="6,5" Height="56" AcceptsReturn="True"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

    </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
