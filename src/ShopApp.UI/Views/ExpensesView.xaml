<UserControl x:Class="ShopApp.UI.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ShopApp.UI.Views">

  <UserControl.Resources>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="6">

    <Border DockPanel.Dock="Top" Style="{StaticResource Panel}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="+  Add Expense" Padding="18,7"
                FontWeight="SemiBold" Foreground="White" Background="#B45309"
                BorderThickness="0" Command="{Binding NewCommand}"/>

        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Filter by:" Style="{StaticResource Caption}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>
          <ComboBox MinWidth="120" ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding Period}"/>
          <DatePicker Margin="8,0,0,0" SelectedDate="{Binding FromDate}"/>
          <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
          <DatePicker SelectedDate="{Binding ToDate}"/>
          <ComboBox Width="180" Margin="16,0,0,0" IsEditable="True"
                    ItemsSource="{Binding Categories}"
                    Text="{Binding CategoryFilter, UpdateSourceTrigger=LostFocus}"
                    ToolTip="Show one category only"/>
          <Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearFiltersCommand}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Total, then where it went. The breakdown always covers the whole
         period, whatever the category filter says. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,10,0,0">
      <Border Style="{StaticResource KpiCard}">
        <StackPanel>
          <TextBlock Text="TOTAL SPENT" Style="{StaticResource KpiLabel}"/>
          <TextBlock Style="{StaticResource KpiValueWarn}" Text="{Binding TotalSpent, StringFormat=Rs {0:N0}}"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource KpiCard}" MinWidth="0">
        <StackPanel>
          <TextBlock Text="BY CATEGORY" Style="{StaticResource KpiLabel}"/>
          <ItemsControl ItemsSource="{Binding ByCategory}" Margin="0,8,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Badge}" Margin="0,0,8,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Category}" Style="{StaticResource BadgeText}"/>
                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}"
                               Style="{StaticResource BadgeText}" Margin="8,0,0,0"
                               Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Padding="2,8,2,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Edit" Padding="18,6" Margin="0,0,8,0"
                  Command="{Binding EditCommand}" IsEnabled="{Binding HasSelection}"/>
          <Button Content="Delete" Padding="14,6" Foreground="#B91C1C"
                  Command="{Binding DeleteCommand}" IsEnabled="{Binding HasSelection}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Panel}" Padding="14" Margin="0,8,0,0">
      <Grid>
      <DataGrid x:Name="Rows" ItemsSource="{Binding Expenses}" SelectedItem="{Binding SelectedExpense}"
                IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="DATE" Width="130"
                              Binding="{Binding Date, StringFormat=dd-MMM-yyyy}"/>
          <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="1.2*"/>
          <DataGridTextColumn Header="COVERS" Binding="{Binding Covers}" Width="1.4*"/>
          <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="2*"/>
          <DataGridTextColumn Header="PAID" Width="130"
                              Binding="{Binding Amount, StringFormat=N2}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Foreground" Value="#64748B"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="THIS PERIOD" Width="140"
                              Binding="{Binding ChargedHere, StringFormat=N2}">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#B45309"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <v:EmptyState Message="No expenses in this period"
                    Hint="Rent, wages, fuel and repairs go here. Press Add Expense to record one."
                    Visibility="{Binding HasItems, ElementName=Rows, Converter={StaticResource NotToVis}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
