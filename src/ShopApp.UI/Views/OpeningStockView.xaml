<UserControl x:Class="ShopApp.UI.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <UserControl.Resources>
    <Style x:Key="RightCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
  </UserControl.Resources>

  <DockPanel Margin="10">

    <Border DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#FDE68A"
            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
      <StackPanel>
        <TextBlock Text="Opening stock" FontSize="15" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" Foreground="#78350F" Margin="0,4,0,0"
                   Text="What is physically in the godown on the day he starts using the app. Enter this once, from a real count - not from the register. Whatever goes in here becomes the starting point for every stock and profit report."/>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="As on" VerticalAlignment="Center"
                     Margin="0,0,8,0" FontWeight="SemiBold"/>
          <DatePicker Grid.Column="1" Width="140" SelectedDate="{Binding AsOfDate}"/>

          <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#78350F"
                     Text="{Binding ExistingOpeningValue, StringFormat=Opening stock already recorded: {0:N2}}"/>
        </Grid>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="6" Padding="12" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                   Text="{Binding StatusMessage}" Foreground="#15803D" TextWrapping="Wrap"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Total value" Foreground="#6B7280" FontSize="11"
                       HorizontalAlignment="Right"/>
            <TextBlock Text="{Binding TotalValue, StringFormat=N2}"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
          </StackPanel>
          <Button Content="Save opening stock" Padding="16,8" FontWeight="Bold"
                  Command="{Binding SaveCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="+ Add row" Padding="10,3" Command="{Binding AddLineCommand}"/>
        <Button Content="Add every item" Margin="8,0,0,0" Padding="10,3"
                Command="{Binding AddAllItemsCommand}"
                ToolTip="Fill a row for every item, then delete the ones he does not stock"/>
        <Button Content="Remove empty rows" Margin="8,0,0,0" Padding="10,3"
                Command="{Binding RemoveEmptyRowsCommand}"/>
      </StackPanel>

      <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False"
                CanUserAddRows="False" SelectionMode="Single"
                HeadersVisibility="Column" RowHeight="30">
        <DataGrid.RowStyle>
          <Style TargetType="DataGridRow">
            <Style.Triggers>
              <DataTrigger Binding="{Binding AlreadyEntered}" Value="True">
                <Setter Property="Background" Value="#FEF3C7"/>
                <Setter Property="ToolTip"
                        Value="Opening stock already exists for this item. Saving again would double it."/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>

          <DataGridTemplateColumn Header="Item" Width="2.2*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ComboBox SelectedItem="{Binding Item, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.AvailableItems,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="Name" IsEditable="True"
                          IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                          BorderThickness="0" Background="Transparent"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Batch" Width="95"
                              Binding="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"/>

          <DataGridTextColumn Header="Packs" Width="65"
                              Binding="{Binding PackQty, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Quantity" Width="95"
                              Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Unit" Width="90" IsReadOnly="True"
                              Binding="{Binding UnitLabel}"/>

          <DataGridTextColumn Header="Cost/Unit" Width="95"
                              Binding="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTextColumn Header="Value" Width="110" IsReadOnly="True"
                              Binding="{Binding Value, StringFormat=N2}"
                              ElementStyle="{StaticResource RightCell}"/>

          <DataGridTemplateColumn Header="Expiry" Width="115">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                            BorderThickness="0"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

          <DataGridTextColumn Header="Location" Width="100"
                              Binding="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}"/>

          <DataGridTemplateColumn Width="40">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="X" Foreground="#B91C1C" BorderThickness="0"
                        Background="Transparent" ToolTip="Remove row"
                        Command="{Binding DataContext.RemoveLineCommand,
                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DockPanel>
</UserControl>
