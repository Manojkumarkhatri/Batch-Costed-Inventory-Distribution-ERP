<Application x:Class="ShopApp.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:conv="clr-namespace:ShopApp.UI.Converters">
  <Application.Resources>
    <ResourceDictionary>

      <!--
        ================= ShopApp design system =================
        Everything a screen needs is defined once, here. Screens
        reference these by key and declare no styles of their own.

        See DESIGN-SYSTEM.md at the repo root for what each one is
        for and when to use it.
        =========================================================
      -->

      <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
      <conv:NavActiveConverter x:Key="NavActive"/>
      <BooleanToVisibilityConverter x:Key="BoolToVis"/>
      <conv:EmptyDashConverter x:Key="Dash"/>
      <conv:NotToVisibilityConverter x:Key="NotToVis"/>
      <conv:NullToVisibilityConverter x:Key="NullToVis"/>
      <conv:RowNumberConverter x:Key="RowNo"/>

      <!-- ========================= 1. COLOUR =========================
           Ink for anything read closely, Muted for labels, Faint for
           asides. Positive and Negative carry meaning and are never
           used decoratively.
      -->
      <!--
        Values below are lifted from the Day Book design, not chosen here.
        Change them there first.
      -->
      <Color x:Key="InkColor">#131720</Color>
      <Color x:Key="AccentColor">#2F5BEA</Color>

      <SolidColorBrush x:Key="Ink"        Color="#131720"/>
      <SolidColorBrush x:Key="InkSoft"    Color="#3D4657"/>
      <SolidColorBrush x:Key="Muted"      Color="#667186"/>
      <SolidColorBrush x:Key="Dim"        Color="#7A8397"/>
      <SolidColorBrush x:Key="Faint"      Color="#98A1B2"/>

      <SolidColorBrush x:Key="Line"       Color="#E1E5EC"/>
      <SolidColorBrush x:Key="LineSoft"   Color="#EFF1F5"/>
      <SolidColorBrush x:Key="LineMid"    Color="#E6EAF1"/>
      <SolidColorBrush x:Key="LineStrong" Color="#DFE3EA"/>

      <SolidColorBrush x:Key="Surface"    Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Wash"       Color="#F7F8FA"/>
      <SolidColorBrush x:Key="Canvas"     Color="#EEF0F4"/>

      <SolidColorBrush x:Key="Accent"     Color="#2F5BEA"/>
      <SolidColorBrush x:Key="AccentDeep" Color="#1D3FB0"/>
      <SolidColorBrush x:Key="AccentWash" Color="#EEF3FF"/>
      <SolidColorBrush x:Key="AccentTint" Color="#EEF3FF"/>

      <SolidColorBrush x:Key="Positive"     Color="#0E7A4B"/>
      <SolidColorBrush x:Key="PositiveWash" Color="#E7F6EE"/>
      <SolidColorBrush x:Key="Negative"     Color="#B42318"/>
      <SolidColorBrush x:Key="NegativeWash" Color="#FDEEEC"/>
      <SolidColorBrush x:Key="NegativeDeep" Color="#A5271D"/>
      <SolidColorBrush x:Key="Warn"         Color="#B54708"/>
      <SolidColorBrush x:Key="WarnWash"     Color="#FEF0C7"/>

      <!-- On the dark grand-total bar the ordinary green and red go muddy. -->
      <SolidColorBrush x:Key="PositiveOnDark" Color="#6DDBA4"/>
      <SolidColorBrush x:Key="NegativeOnDark" Color="#FF9E93"/>

      <SolidColorBrush x:Key="RailBase"    Color="#10141C"/>
      <SolidColorBrush x:Key="RailHover"   Color="#1D2432"/>
      <SolidColorBrush x:Key="RailText"    Color="#98A1B2"/>

      <!-- Table furniture. -->
      <SolidColorBrush x:Key="SectionRow"  Color="#F1F4FA"/>
      <SolidColorBrush x:Key="SectionText" Color="#35405A"/>
      <SolidColorBrush x:Key="SubtotalRow" Color="#FBFCFD"/>
      <SolidColorBrush x:Key="DashInk"     Color="#C0C6D2"/>

      <SolidColorBrush x:Key="RowHover"    Color="#FAFBFD"/>
      <SolidColorBrush x:Key="RowPicked"   Color="#EEF3FF"/>
      <SolidColorBrush x:Key="RowPickedHover" Color="#E4ECFF"/>

      <!--
        IBM Plex, with a fallback for machines that do not have it. Numbers and
        dates are ALWAYS mono: it is what makes a column of figures scan.
      -->
      <FontFamily x:Key="UiFont">IBM Plex Sans, Segoe UI, Arial</FontFamily>
      <FontFamily x:Key="NumFont">IBM Plex Mono, Consolas, Courier New</FontFamily>

      <!-- ======================== 2. METRICS ========================
           One spacing ladder. Anything not on it is a mistake.
      -->
      <sys:Double x:Key="Space1">4</sys:Double>
      <sys:Double x:Key="Space2">8</sys:Double>
      <sys:Double x:Key="Space3">12</sys:Double>
      <sys:Double x:Key="Space4">16</sys:Double>
      <sys:Double x:Key="Space5">20</sys:Double>
      <sys:Double x:Key="Space6">28</sys:Double>

      <Thickness x:Key="CardPadding">20</Thickness>
      <Thickness x:Key="CardGap">0,0,0,10</Thickness>
      <CornerRadius x:Key="RadiusCard">8</CornerRadius>
      <CornerRadius x:Key="RadiusControl">6</CornerRadius>
      <CornerRadius x:Key="RadiusPill">12</CornerRadius>
      <CornerRadius x:Key="RadiusKpi">12</CornerRadius>

      <!-- shadow-sm. Kept faint: on a dense screen a heavy shadow reads as
           clutter, and every card would carry it. -->
      <DropShadowEffect x:Key="ShadowSm" BlurRadius="6" ShadowDepth="1"
                        Direction="270" Opacity="0.07" Color="#0F172A"/>

      <!-- ====================== 3. TYPE SCALE ======================
           Six sizes, no more. PageTitle is the screen name, Figure is
           a number worth looking at, Micro is a tile caption.
      -->
      <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <Style x:Key="SectionHead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <!-- Beside a field or a filter. -->
      <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,12,0,3"/>
      </Style>

      <!-- Same size, laid out horizontally in a filter bar. -->
      <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
        <Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </Style>

      <!-- An aside. Never a paragraph: if it needs one, the screen is wrong. -->
      <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
      </Style>

      <!-- The caption above a number. Small, uppercase, quiet. -->
      <Style x:Key="Micro" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      </Style>

      <!-- Numbers. Tabular so columns of figures line up on the decimal. -->
      <Style x:Key="Figure" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      </Style>

      <Style x:Key="FigureSmall" TargetType="TextBlock" BasedOn="{StaticResource Figure}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <!-- ======================= 4. SURFACES ======================= -->

      <!-- The only container. Every screen is cards on the canvas. -->
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
      </Style>

      <!-- A card holding a filter strip: same shell, less padding. -->
      <Style x:Key="FilterBar" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12"/>
      </Style>

      <!-- A card holding a grid: the grid supplies its own row padding. -->
      <Style x:Key="GridCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14"/>
      </Style>

      <!-- One figure with a caption, in a row of them above a table. -->
      <Style x:Key="StatTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Wash}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        <Setter Property="Padding" Value="16,10,20,10"/>
        <Setter Property="Margin" Value="0,0,10,8"/>
        <Setter Property="MinWidth" Value="130"/>
      </Style>

      <!-- ===================== 4b. KPI CARDS =====================
           One figure in its own card. Screens put a row of these above
           the table instead of floating text. Always KpiLabel over
           KpiValue, never a bare number.
      -->
      <Style x:Key="KpiCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource RadiusKpi}"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="MinWidth" Value="150"/>
      </Style>

      <Style x:Key="KpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      </Style>

      <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      </Style>

      <Style x:Key="KpiValuePositive" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
        <Setter Property="Foreground" Value="{StaticResource Positive}"/>
      </Style>

      <Style x:Key="KpiValueNegative" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
        <Setter Property="Foreground" Value="{StaticResource Negative}"/>
      </Style>

      <Style x:Key="KpiValueWarn" TargetType="TextBlock" BasedOn="{StaticResource KpiValue}">
        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
      </Style>

      <!-- A note under the figure explaining what it is made of. -->
      <Style x:Key="KpiSub" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Margin" Value="0,6,0,0"/>
      </Style>

      <!-- WPF has no gap, so every control in a filter bar carries its own
           right margin. Apply to each child of the filter StackPanel. -->
      <Style x:Key="FilterItem" TargetType="FrameworkElement">
        <Setter Property="Margin" Value="0,0,16,0"/>
      </Style>

      <!-- ==================== 5. STATUS BADGES ====================
           A coloured pill in a table cell. Read the shape before the
           word. Use inside a DataGridTemplateColumn.
      -->
      <Style x:Key="Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{StaticResource Canvas}"/>
      </Style>

      <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <Style x:Key="BadgeSale" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource NegativeWash}"/>
      </Style>

      <!-- Section heading row inside a report table. -->
      <Style x:Key="SectionHeadingText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SectionText}"/>
      </Style>
      <Style x:Key="BadgePurchase" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource AccentTint}"/>
      </Style>
      <Style x:Key="BadgeMoneyIn" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource PositiveWash}"/>
      </Style>
      <Style x:Key="BadgeMoneyOut" TargetType="Border" BasedOn="{StaticResource Badge}">
        <Setter Property="Background" Value="{StaticResource WarnWash}"/>
      </Style>

      <!-- ======================= 6. BUTTONS =======================
           Secondary is the default. Primary once per card at most.
      -->
      <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" CornerRadius="8"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource Wash}"/>
                  <Setter TargetName="Root" Property="Opacity" Value="0.94"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Root" Property="Opacity" Value="0.78"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                  <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="18,7"/>
      </Style>

      <!-- Sale and money-in actions. -->
      <Style x:Key="SaleButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#DC2626"/>
      </Style>

      <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Positive}"/>
      </Style>

      <!-- Destructive. Quiet until pressed - never a filled red block. -->
      <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource Negative}"/>
        <Setter Property="Background" Value="Transparent"/>
      </Style>

      <!-- A date preset or a chip in a filter bar. -->
      <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="MinHeight" Value="30"/>
      </Style>

      <!-- One segment of a segmented control. Flat inside a tinted track;
           the active one is lifted white, as in the design. -->
      <Style x:Key="SegButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#576072"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Margin" Value="0"/>
      </Style>

      <Style x:Key="SegButtonActive" TargetType="Button" BasedOn="{StaticResource SegButton}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      </Style>

      <!-- ======================== 7. INPUTS ======================== -->
      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="Root" CornerRadius="8"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource Wash}"/>
                </Trigger>
                <!-- A number that will not convert keeps the old value and
                     saves it silently. This makes that impossible to miss. -->
                <Trigger Property="Validation.HasError" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Negative}"/>
                  <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
                  <Setter Property="ToolTip"
                          Value="{Binding RelativeSource={RelativeSource Self},
                                  Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ==================== 7b. PICKERS ====================
           ComboBox and DatePicker templated properly. The stock Windows
           chrome is a gradient from another decade and was the last thing
           on screen that did not belong.

           The editable path is handled explicitly: PART_EditableTextBox
           and PART_Popup must exist and be named exactly, or the unit,
           party and group pickers break at runtime rather than at build.
      -->
      <Style x:Key="PickerToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Geometry x:Key="IcoChevronDown">M5 8.5 L10 13.5 L15 8.5</Geometry>
      <Geometry x:Key="IcoCalendar">M4.5 6.5 H19.5 V19.5 H4.5 Z M4.5 10 H19.5
                                    M8.5 4.5 V8 M15.5 4.5 V8</Geometry>

      <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}"
                      CornerRadius="5" Margin="4,1">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentWash}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentTint}"/>
                  <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <Border x:Name="Root" CornerRadius="8"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>

                    <!--
                      Full RelativeSource bindings, not TemplateBinding.
                      SelectionBoxItemTemplate is generated by the ComboBox
                      after the template is applied when DisplayMemberPath is
                      used, and TemplateBinding does not pick that up - the
                      cell then falls back to ToString and shows the record,
                      "PartyRow { Id = 1, ... }", instead of the name.
                    -->
                    <ContentPresenter x:Name="Selected" Margin="11,0"
                                      VerticalAlignment="Center" IsHitTestVisible="False"
                                      Content="{Binding SelectionBoxItem,
                                                RelativeSource={RelativeSource TemplatedParent}}"
                                      ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                       RelativeSource={RelativeSource TemplatedParent}}"
                                      ContentTemplateSelector="{Binding ItemTemplateSelector,
                                                               RelativeSource={RelativeSource TemplatedParent}}"
                                      ContentStringFormat="{Binding SelectionBoxItemStringFormat,
                                                           RelativeSource={RelativeSource TemplatedParent}}"/>

                    <TextBox x:Name="PART_EditableTextBox" Margin="7,0" Visibility="Collapsed"
                             Background="Transparent" BorderThickness="0" Padding="4,0"
                             VerticalContentAlignment="Center"
                             Foreground="{TemplateBinding Foreground}"/>

                    <Path x:Name="Chevron" Grid.Column="1" Width="13" Height="13"
                          Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="{StaticResource IcoChevronDown}"
                          Stroke="{StaticResource Faint}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"/>
                  </Grid>
                </Border>

                <!-- Whole control opens the list; when editable, only the arrow. -->
                <ToggleButton x:Name="Toggle" Style="{StaticResource PickerToggle}"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                          RelativeSource={RelativeSource TemplatedParent}}"/>

                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                       Focusable="False" PopupAnimation="Fade"
                       IsOpen="{TemplateBinding IsDropDownOpen}">
                  <Border Margin="0,4,0,0" CornerRadius="8" Padding="0,4"
                          Background="{StaticResource Surface}"
                          BorderBrush="{StaticResource Line}" BorderThickness="1"
                          MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsPresenter/>
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>

              <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
                  <!-- The overlay must not swallow clicks meant for the text box. -->
                  <Setter TargetName="Toggle" Property="Grid.Column" Value="1"/>
                  <Setter TargetName="Toggle" Property="HorizontalAlignment" Value="Right"/>
                  <Setter TargetName="Toggle" Property="Width" Value="30"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Faint}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource Wash}"/>
                  <Setter Property="Foreground" Value="{StaticResource Faint}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!--
        DatePicker is two controls in a trench coat: a DatePickerTextBox and
        a calendar button. Both are templated here, and PART_TextBox,
        PART_Button and PART_Popup keep those exact names because the control
        locates them by name at runtime.
      -->
      <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DatePickerTextBox">
              <ScrollViewer x:Name="PART_ContentHost" Margin="0" Padding="0"
                            VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="CalendarToggle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent">
                <Path Width="15" Height="15" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="{StaticResource IcoCalendar}"
                      Stroke="{StaticResource Faint}" StrokeThickness="1.4"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="DatePicker">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DatePicker">
              <Border x:Name="Root" CornerRadius="8"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>

                  <DatePickerTextBox x:Name="PART_TextBox" Margin="11,0"
                                     VerticalAlignment="Center"/>

                  <Button x:Name="PART_Button" Grid.Column="1"
                          Style="{StaticResource CalendarToggle}"/>

                  <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                         StaysOpen="False"/>
                </Grid>
              </Border>

              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Faint}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                  <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource Wash}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <!-- ======================== 8. TABLES ========================
           Rows ruled across, columns divided in the header only.
           Verticals down the body turn a list into a spreadsheet.
      -->
      <Style TargetType="DataGrid">
        <Setter Property="RowHeight" Value="46"/>
        <Setter Property="FontSize" Value="13.5"/>
        <!-- Ruled both ways, very faintly. Columns of figures need the
             vertical guide; anything darker turns it into a spreadsheet. -->
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineSoft}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource LineSoft}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="ColumnHeaderHeight" Value="44"/>
      </Style>

      <!-- Headers are written uppercase in the markup - WPF has no
           text-transform, so Header="PARTY NAME" is the convention. -->
      <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Wash}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>

      <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource RowHover}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource RowPicked}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
          </Trigger>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="IsSelected" Value="True"/>
              <Condition Property="IsMouseOver" Value="True"/>
            </MultiTrigger.Conditions>
            <Setter Property="Background" Value="{StaticResource RowPickedHover}"/>
          </MultiTrigger>
        </Style.Triggers>
      </Style>

      <!--
        Cells stay transparent so the row colour shows through. Without
        this the system highlight paints each cell blue and flips the
        text white, losing the red and green in the money columns.

        VerticalAlignment must be Stretch: Center shrinks the cell to
        its text and draws a second line inside the row.
      -->
      <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <!--
          Templated deliberately. Padding and VerticalContentAlignment on the
          stock DataGridCell do not reach the TextBlock a DataGridTextColumn
          generates, which is why only columns naming an ElementStyle were
          ever spaced. Here the Border pads and the presenter centres, so
          every column behaves whether it names a style or not.
        -->
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter VerticalAlignment="Center"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  SnapsToDevicePixels="True"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Line-item grids on the sale and purchase forms are for typing
           into. There the column dividers do carry down, or the cell you
           are typing in stops lining up with its header. -->
      <Style x:Key="EntryGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Line}"/>
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style>

      <!-- ============== 9. CELL STYLES FOR COLUMNS ==============
           Apply with DataGridTextColumn.ElementStyle. Numbers are
           always right-aligned and tabular; text never is.
      -->
      <!-- A numeric column header. Must match its cells, or the figures
           appear to sit under the next header along. -->
      <Style x:Key="NumberColumnHeader" TargetType="DataGridColumnHeader"
             BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
      </Style>

      <!-- The serial column. Quiet: it is a landmark, not information. -->
      <Style x:Key="RowNumberCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
          <!-- A subtotal is not an entry, so it does not take a number. -->
          <DataTrigger Binding="{Binding IsSummaryRow}" Value="True">
            <Setter Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- Text that will not fit is trimmed, with the full value on hover.
           Wrapping a name mid-row breaks the alignment of the whole line. -->
      <Style x:Key="TextCell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
      </Style>

      <Style x:Key="DateCell" TargetType="TextBlock" BasedOn="{StaticResource TextCell}">
        <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      </Style>

      <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      </Style>

      <Style x:Key="MoneyCell" TargetType="TextBlock" BasedOn="{StaticResource NumberCell}">
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Style>

      <Style x:Key="MoneyInCell" TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}">
        <Setter Property="Foreground" Value="{StaticResource Positive}"/>
      </Style>

      <Style x:Key="MoneyOutCell" TargetType="TextBlock" BasedOn="{StaticResource MoneyCell}">
        <Setter Property="Foreground" Value="{StaticResource Negative}"/>
      </Style>

      <!-- A row for something voided: present, legible, plainly not live. -->
      <Style x:Key="VoidedRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsCancelled}" Value="True">
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FontStyle" Value="Italic"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <!-- ==================== 10. LIST NAVIGATION ====================
           The report list, and anything else that is a column of
           choices rather than a table.
      -->
      <Style x:Key="NavListItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="Root" Background="Transparent" Padding="16,7" Margin="0,1">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentWash}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentTint}"/>
                  <Setter Property="Foreground" Value="{StaticResource AccentDeep}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="NavGroupHead" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="16,10,0,4"/>
      </Style>

      <!-- ======================= 11. CHROME ======================= -->
      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      </Style>

      <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource Wash}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      </Style>

      <Style x:Key="DialogHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Wash}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,14"/>
      </Style>

      <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Wash}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="20,12"/>
      </Style>

      <!-- Placeholder text layered over an empty TextBox. See PartiesView for
           the two-element pattern this is used with. -->
      <Style x:Key="Watermark" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
      </Style>

      <!-- The caption above a figure in a detail pane. -->
      <Style x:Key="StatCaption" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
        <Setter Property="Margin" Value="0,0,0,4"/>
      </Style>

      <Style x:Key="StatusLine" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
        <Setter Property="Margin" Value="2,8,0,0"/>
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
