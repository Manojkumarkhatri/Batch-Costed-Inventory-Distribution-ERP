<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShopApp</AssemblyName>

    <!--
      Velopack needs its hook to run before WPF starts, which means our own
      Main. That in turn means App.xaml must be compiled as a Page rather than
      as the application definition, or the SDK generates a second Main and
      the build fails with CS0017.
    -->
    <StartupObject>ShopApp.UI.Program</StartupObject>

    <!--
      The version stamped into the exe. Velopack compares this with what is on
      the update server, so it has to be raised for every release or the
      client will never see one.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- overrides the SDK's default ApplicationDefinition for App.xaml -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" Generator="MSBuild:Compile" SubType="Designer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- design-time only: required by `dotnet ef` in the STARTUP project -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ShopApp.Domain/ShopApp.Domain.csproj" />
    <ProjectReference Include="../ShopApp.Data/ShopApp.Data.csproj" />
    <ProjectReference Include="../ShopApp.Services/ShopApp.Services.csproj" />
  </ItemGroup>
</Project>
